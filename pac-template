var hop = Object.prototype.hasOwnProperty;

function isIpAddress(ip) {
    // Quick reject: first char outside IP range
    // IP addresses start with: digit(0-9) for IPv4, '[' for IPv6 literal, hex for raw IPv6
    // All lowercase letters (a-z) are domain names — PAC/lowercases hosts, so this covers 99%+ domains
    var c = ip.charCodeAt(0);
    if (c >= 97) return false;          // a-z → always a domain name, IPv6 hex segments are lowercase in URL hosts
    if (c >= 71 && c <= 90) return false;  // G-Z uppercase → always a domain name
    if (c >= 48 && c <= 57) {}          // 0-9 → could be IPv4
    else if (c !== 91) return false;    // only '[' is allowed (IPv6 literal)
    return /^\d{1,3}(\.\d{1,3}){3}$/.test(ip) || /^([0-9a-fA-F]{0,4}:){1,7}[0-9a-fA-F]{0,4}$/.test(ip);
}

function RadixTree() {
    this.root = {};
}

RadixTree.prototype.insert = function(string) {
    var node = this.root;
    for (var i = 0; i < string.length; i++) {
        var char = string.charAt(i);
        if (!hop.call(node, char)) {
            node[char] = {};
        }
        node = node[char];
    }
    // 显式终止标记：嵌套 CIDR（短前缀包含长前缀）也能正确命中
    node[''] = true;
};

RadixTree.prototype.search = function(string) {
    if (!string || string.length === 0) return false;
    var node = this.root;
    for (var i = 0; i < string.length; i++) {
        // 路径上任一 CIDR 前缀终止即命中
        if (hop.call(node, '')) return true;
        var char = string.charAt(i);
        if (!hop.call(node, char)) return false;
        node = node[char];
    }
    return hop.call(node, '');
};

function ipToBinary(ip) {
    // IPv6 check first (IPv4 never contains ':')
    if (ip.indexOf(':') !== -1) {
        // Expand the IPv6 address if it contains '::'
        var parts = ip.split('::');
        var left = parts[0] ? parts[0].split(':') : [];
        var right = parts[1] ? parts[1].split(':') : [];

        // Calculate the number of zero groups to insert
        var zeroGroups = 8 - (left.length + right.length);

        // Create the full address by inserting zero groups
        var fullAddress = left.slice();
        for (var z = 0; z < zeroGroups; z++) fullAddress.push('0');
        fullAddress = fullAddress.concat(right);

        // Convert each group to binary and pad to 16 bits (ES3-safe: no Array.map)
        var binary = '';
        for (var i = 0; i < fullAddress.length; i++) {
            var group = fullAddress[i] || '0';
            binary += ("0000000000000000" + parseInt(group, 16).toString(2)).slice(-16);
        }
        return binary;
    }
    // IPv4 (ES3-safe: no Array.map)
    var octets = ip.split('.');
    var binaryV4 = '';
    for (var j = 0; j < octets.length; j++) {
        binaryV4 += ("00000000" + parseInt(octets[j], 10).toString(2)).slice(-8);
    }
    return binaryV4;
}
  
function isInDirectDomain(host) {
    // O(1) exact match — hasOwnProperty guard for prototype safety
    if (hop.call(directDomainHash, host)) return true;
    // O(k) suffix match (k = number of dots in hostname, typically < 5)
    for (var idx = host.indexOf('.'); idx !== -1; idx = host.indexOf('.', idx + 1)) {
        if (hop.call(directDomainHash, host.substring(idx + 1))) return true;
    }
    return false;
}

function isInProxyDomain(host) {
    // O(1) exact match — hasOwnProperty guard for prototype safety
    if (hop.call(proxyDomainHash, host)) return true;
    // O(k) suffix match
    for (var idx = host.indexOf('.'); idx !== -1; idx = host.indexOf('.', idx + 1)) {
        if (hop.call(proxyDomainHash, host.substring(idx + 1))) return true;
    }
    return false;
}

function isLocalTestDomain(domain) {
    // Chrome uses .test as testing gTLD.
    var tld = domain.substring(domain.lastIndexOf('.'));
    if (tld === domain) {
        return false;
    }
    for (var i = 0; i < localTlds.length; i++) {
        if (tld === localTlds[i]) return true;
    }
    return false;
}

// Known GFW DNS pollution IPs — dnsResolve may return these for blocked domains.
// They fall within Chinese CIDR ranges but do NOT host the requested service.
var dnsPollutionHash = {};

function isDnsPollutionIp(ip) {
    return hop.call(dnsPollutionHash, ip);
}

/* https://github.com/frenchbread/private-ip */
function isPrivateIp(ip) {
    return /^(::f{4}:)?10\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$/i.test(ip) ||
        /^(::f{4}:)?192\.168\.([0-9]{1,3})\.([0-9]{1,3})$/i.test(ip) ||
        /^(::f{4}:)?172\.(1[6-9]|2\d|30|31)\.([0-9]{1,3})\.([0-9]{1,3})$/i.test(ip) ||
        /^(::f{4}:)?127\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$/i.test(ip) ||
        /^(::f{4}:)?169\.254\.([0-9]{1,3})\.([0-9]{1,3})$/i.test(ip) ||
        /^f[cd][0-9a-f]{2}:/i.test(ip) ||
        /^fe80:/i.test(ip) ||
        /^::1$/.test(ip) ||
        /^::$/.test(ip);
}

function FindProxyForURL(url, host) {
    // Guard: empty/null host — defensive programming for edge cases
    if (!host || host.length === 0) {
        return direct;
    }

    // FAST PATH 1: IP address host — skip domain matching, go straight to CIDR
    if (isIpAddress(host)) {
        if (isPrivateIp(host)) {
            return direct;
        }
        if (radixTree.search(ipToBinary(host))) {
            return direct;
        }
        return proxy;
    }

    // FAST PATH 2: Plain hostname or local domain — no DNS needed
    if (isPlainHostName(host) || host === 'localhost' || isLocalTestDomain(host)) {
        return direct;
    }

    // FAST PATH 3: Hash-based domain lookup — O(1) exact + O(k) suffix
    if (isInDirectDomain(host)) {
        return direct;
    }
    if (isInProxyDomain(host)) {
        return proxy;
    }

    // DNS PATH: TLD heuristic — skip DNS for overwhelmingly foreign TLDs
    // (.com, .org, .net, .io, .dev, .app... are 99%+ non-Chinese)
    var tld = host.substring(host.lastIndexOf('.'));
    if (foreignTLDs[tld]) {
        return proxy;
    }

    // Chinese or unknown TLD — DNS resolve + CIDR matching
    var ip = dnsResolve(host);

    if (!ip) {
        return proxy;
    }
    if (isPrivateIp(ip)) {
        return direct;
    }
    // DNS pollution guard: GFW returns fake Chinese IPs for blocked domains.
    // Override CIDR match — force PROXY when IP is a known pollution address.
    if (isDnsPollutionIp(ip)) {
        return proxy;
    }
    if (radixTree.search(ipToBinary(ip))) {
        return direct;
    }

    return proxy;
}

